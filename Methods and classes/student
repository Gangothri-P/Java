
class ResultSummary {

    private String name;
    private int total;
    private double average;

    ResultSummary(String name, int total, double average) {
        this.name = name;
        this.total = total;
        this.average = average;
    }

    void displaySummary() {
        System.out.println("Student Name: " + name);
        System.out.println("Total Marks: " + total);
        System.out.println("Average: " + average);
    }
}

public class Student {

    private String usn;
    private String name;

    private int mark1;
    private int mark2;
    private int mark3;

    static int studentCount = 0;

    final int MAX_MARKS = 100;

    // Constructor
    Student(String usn, String name,
            int mark1, int mark2, int mark3) {

        if (!validateMarks(mark1, mark2, mark3)) {
            throw new IllegalArgumentException(
                "Marks must be between 0 and 100"
            );
        }

        this.usn = usn;
        this.name = name;
        this.mark1 = mark1;
        this.mark2 = mark2;
        this.mark3 = mark3;

        studentCount++;
    }

    // Validation method
    boolean validateMarks(int a, int b, int c) {
        return a >= 0 && a <= 100 &&
               b >= 0 && b <= 100 &&
               c >= 0 && c <= 100;
    }

    // Getter methods
    String getUSN() {
        return usn;
    }

    String getName() {
        return name;
    }

    int getMark1() {
        return mark1;
    }

    int getMark2() {
        return mark2;
    }

    int getMark3() {
        return mark3;
    }

    // Calculate total
    int calculateTotal() {
        return mark1 + mark2 + mark3;
    }

    // Calculate average
    double calculateAverage() {
        return calculateTotal() / 3.0;
    }

    // Display basic details
    void display() {
        System.out.println("USN: " + usn);
        System.out.println("Name: " + name);
    }

    // Overloaded display method
    void display(boolean showResult) {
        display();

        if (showResult) {
            System.out.println("Total: " + calculateTotal());
            System.out.println("Average: " + calculateAverage());
        }
    }

    // Return result summary object
    ResultSummary getResultSummary() {
        return new ResultSummary(
            name,
            calculateTotal(),
            calculateAverage()
        );
    }

    public static void main(String[] args) {

        Student s1 = new Student(
            "1AB23CS001", "Rahul", 85, 90, 95
        );

        Student s2 = new Student(
            "1AB23CS002", "Priya", 80, 75, 90
        );

        System.out.println("Student 1 Details:");
        s1.display(true);

        System.out.println("\nStudent 2 Details:");
        s2.display(true);

        System.out.println("\nTotal Students: " + studentCount);

        System.out.println("\nResult Summary:");
        ResultSummary result = s1.getResultSummary();
        result.displaySummary();
    }
}
